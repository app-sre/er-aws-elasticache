{
  "data": {
    "region": "us-east-1",
    "identifier": "{{run_id}}",
    "output_resource_name": "{{run_id}}",
    "output_prefix": "{{run_id}}-elasticache",
    "tags": {
      "managed_by_integration": "external_resources",
      "cluster": "appint-ex-01",
      "namespace": "example-elasticache-01",
      "environment": "production",
      "app": "erv2-itest"
    },
    "environment": "production",
    "service_updates_enabled": true,
    "service_updates_types": [
      "engine-update",
      "security-update",
      "engine-major-version-update"
    ],
    "service_updates_severities": ["critical", "important", "medium"],
    "service_updates_cooldown_days": 14,
    "apply_immediately": true,
    "at_rest_encryption_enabled": true,
    "auto_minor_version_upgrade": false,
    "automatic_failover_enabled": true,
    "reset_password": "erv2-itest-full-scenario-v1",
    "replication_group_description": "erv2_itest full-options throwaway instance - safe to delete",
    "engine": "valkey",
    "engine_version": "7.2",
    "log_delivery_configuration": [
      {
        "destination": "cloudwatch-example-02",
        "destination_type": "cloudwatch-logs",
        "log_type": "slow-log",
        "log_format": "json"
      }
    ],
    "maintenance_window": "wed:10:00-wed:11:00",
    "multi_az_enabled": true,
    "node_type": "cache.t4g.micro",
    "number_cache_clusters": 2,
    "parameter_group": {
      "name": "{{run_id}}-custom-pg",
      "family": "valkey7",
      "description": "erv2_itest parameter group",
      "parameters": [
        {
          "name": "tcp-keepalive",
          "value": "300"
        }
      ]
    },
    "parameter_group_name": "{{run_id}}-custom-pg",
    "port": 6380,
    "availability_zones": ["us-east-1a", "us-east-1c"],
    "replication_group_id": "{{run_id}}",
    "security_group_ids": ["sg-0d44ec58a69cc7d62"],
    "snapshot_retention_limit": 2,
    "snapshot_window": "03:30-05:30",
    "subnet_group_name": "default",
    "transit_encryption_enabled": true,
    "transit_encryption_mode": "required"
  },
  "provision": {
    "provision_provider": "aws",
    "provisioner": "app-int-example-01",
    "provider": "elasticache",
    "identifier": "{{run_id}}",
    "target_cluster": "appint-ex-01",
    "target_namespace": "example-elasticache-01",
    "target_secret_name": "{{run_id}}",
    "module_provision_data": {
      "tf_state_bucket": "external-resources-terraform-state-dev",
      "tf_state_region": "us-east-1",
      "tf_state_dynamodb_table": "external-resources-terraform-lock",
      "tf_state_key": "aws/app-int-example-01/elasticache/{{run_id}}/terraform.tfstate"
    }
  }
}
